@model List<ABCRetail.Models.Order>

<div class="page-card">
    <h2>Orders</h2>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <h5 class="card-title">Total Orders</h5>
                    <h2 class="card-text">@Model.Count</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <h5 class="card-title">Processing</h5>
                    <h2 class="card-text">@Model.Count(o => o.Action == "ProcessOrder")</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <h5 class="card-title">Completed</h5>
                    <h2 class="card-text">@Model.Count(o => o.Action == "Completed")</h2>
                </div>
            </div>
        </div>
    </div>

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Order ID</th>
                <th>Product</th>
                <th>Action</th>
                <th>Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var order in Model)
            {
                <tr>
                    <td>@order.OrderId.Substring(0, 8)</td>
                    <td>@order.ProductName</td>
                    <td>
                        <span class="badge @(order.Action == "ProcessOrder" ? "bg-warning" : "bg-success")">
                            @order.Action
                        </span>
                    </td>
                    <td>@order.Timestamp.ToString("yyyy-MM-dd HH:mm")</td>
                </tr>
            }
        </tbody>
    </table>
</div>