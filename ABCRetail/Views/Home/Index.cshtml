@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome to ABC Retail</h1>
    <p class="lead">A cloud-native retail management system built on Azure Storage.</p>

    <div class="row mt-4 d-flex align-items-stretch justify-content-center">
        <div class="col-md-3 d-flex">
            <div class="card p-3 h-100 w-100 d-flex flex-column justify-content-between">
                <div>
                    <h5>Customers</h5>
                    <p>Manage customer profiles</p>
                </div>
                <a asp-controller="Customer" asp-action="Index" class="btn btn-primary">View Customers</a>
            </div>
        </div>
        <div class="col-md-3 d-flex">
            <div class="card p-3 h-100 w-100 d-flex flex-column justify-content-between">
                <div>
                    <h5>Products</h5>
                    <p>Browse and manage product catalog</p>
                </div>
                <a asp-controller="Product" asp-action="Index" class="btn btn-primary">View Products</a>
            </div>
        </div>
        <div class="col-md-3 d-flex">
            <div class="card p-3 h-100 w-100 d-flex flex-column justify-content-between">
                <div>
                    <h5>Orders</h5>
                    <p>Place a new order</p>
                </div>
                <a asp-controller="Order" asp-action="Create" class="btn btn-primary">Place Order</a>
            </div>
        </div>
    </div>
</div>