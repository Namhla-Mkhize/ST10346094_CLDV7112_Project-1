@model List<ABCRetail.Models.Customer>

<div class="page-card">
    <h2>Customers</h2>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">@TempData["Message"]</div>
    }

    <a asp-action="Create" class="btn btn-primary mb-3">Add Customer</a>

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Name</th>
                <th>Surname</th>
                <th>Email</th>
                <th>Phone</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var customer in Model)
            {
                <tr>
                    <td>@customer.Name</td>
                    <td>@customer.Surname</td>
                    <td>@customer.Email</td>
                    <td>@customer.PhoneNumber</td>
                    <td>
                        <a asp-action="Edit" asp-route-partitionKey="@customer.PartitionKey" asp-route-rowKey="@customer.RowKey" class="btn btn-outline-secondary btn-sm">Edit</a>
                        <form asp-action="Delete" method="post" style="display:inline">
                            <input type="hidden" name="partitionKey" value="@customer.PartitionKey" />
                            <input type="hidden" name="rowKey" value="@customer.RowKey" />
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>