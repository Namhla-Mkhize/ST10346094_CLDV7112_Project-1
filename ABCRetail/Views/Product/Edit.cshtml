@model ABCRetail.Models.Product

<div class="page-card">
    <h2>Edit Product</h2>

    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <input type="hidden" asp-for="PartitionKey" />
        <input type="hidden" asp-for="RowKey" />
        <input type="hidden" asp-for="ETag" />
        <input type="hidden" asp-for="ImageUrl" />

        <div class="mb-3">
            <label class="form-label">Product Name</label>
            <input asp-for="ProductName" class="form-control" />
        </div>
        <div class="mb-3">
            <label class="form-label">Description</label>
            <textarea asp-for="ProductDescription" class="form-control" rows="3"></textarea>
        </div>
        <div class="mb-3">
            <label class="form-label">Price (ZAR)</label>
            <input asp-for="Price" class="form-control" type="number" step="0.01" />
        </div>
        <div class="mb-3">
            <label class="form-label">Current Image</label>
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <div>
                    <img src="@Model.ImageUrl" alt="@Model.ProductName" style="max-width:150px;max-height:150px;" />
                </div>
            }
            else
            {
                <p class="text-muted">No image uploaded</p>
            }
        </div>
        <div class="mb-3">
            <label class="form-label">Upload New Image (optional)</label>
            <input type="file" name="imageFile" class="form-control" accept="image/*" />
        </div>
        <button type="submit" class="btn btn-primary">Save Changes</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>